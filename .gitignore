# InoProShop / CODESYS user preferences and project locks
*.opt
*.project.~u
*.project.lock

# Automatic saves and local backup copies
*.autosave
*.backup
*.projectbackup
*.bak

# Whole-project backup copies. Git is the backup of record now, so these are
# never versioned: apply_sources writes one before every code push, and manual
# checkpoints (<name>-before-<change>-<time>.project) belong in history only as
# commits. CODESYS-native .projectarchive checkpoints are still tracked.
*-before-*.project
*broken*.project
*.project.bak-*
*.project.before-*
*.project.before

# Generated compiler caches and PLC application binaries
*.precompilecache
*.compileinfo
*.bootinfo
*.bootinfo_guids
*.app
*.crc

# Temporary task-configuration exports used during debugging
/_taskcfg.xml
/_taskcfg_fixed.xml

# Logs and temporary files
*.log
*.tmp
*.temp

# Windows / macOS metadata
Thumbs.db
Desktop.ini
.DS_Store

# Keep the .project source, .projectarchive checkpoints, documentation,
# and any source files under CppProject/ or Data/ in version control.
