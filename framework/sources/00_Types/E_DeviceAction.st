(* 模块说明：统一设备动作类型。未请求或停止时取消动作；定位完成依据本次命令序号判断。 *)
{attribute 'qualified_only'}
TYPE E_DeviceAction :
(
    None := 0, (* 无动作请求，取消当前动作 *)
    Position := 1, (* 定位到指定目标，等待本次序号完成 *)
    Run := 2, (* 保持连续运行请求 *)
    Jog := 3, (* 保持点动，速度正负决定方向 *)
    Stop := 4, (* 取消动作，停止运行 *)
    Home := 5 (* 回零：按轴配置的回零方式寻找原点，完成后把轴坐标设为回零坐标 *)
);
END_TYPE
