(* 模块说明：Modbus 收发缓冲区，索引从 0 开始，尚未绑定网络寄存器。实际地址和字序需另行配置。 *)
VAR_GLOBAL
    (* 仅预留收发缓冲区，尚未绑定工程中的 MODBUS_TCP 网络映射。 *)
    xEnable : BOOL; (* 启用 Modbus 缓冲区解析，默认 FALSE；不代表网络映射已经配置。 *)
    awRx : ARRAY[0..31] OF WORD; (* v2 接收字：0=版本2，1=序号，2=命令2启动/3停止；3/4 保留且必须为0，不接受模式写入。 *)
    awTx : ARRAY[0..127] OF WORD; (* 发布字缓冲区 0..127；包含确认、状态、报警、计数和位置，详见程序内索引注释。 *)
END_VAR

